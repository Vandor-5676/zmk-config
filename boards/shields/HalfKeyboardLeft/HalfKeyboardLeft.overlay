#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "HalfKeyboardLeft Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys
            = <&key_physical_attrs 19 19   0   0 0 0 0>
            , <&key_physical_attrs 19 19  24   0 0 0 0>
            , <&key_physical_attrs 19 19   0  24 0 0 0>
            , <&key_physical_attrs 19 19  24  24 0 0 0>
            , <&key_physical_attrs 19 19   0  48 0 0 0>
            , <&key_physical_attrs 19 19  24  48 0 0 0>
            , <&key_physical_attrs 19 19   0  72 0 0 0>
            , <&key_physical_attrs 19 19  24  72 0 0 0>
            , <&key_physical_attrs 19 19   0  96 0 0 0>
            , <&key_physical_attrs 19 19  24  96 0 0 0>
            , <&key_physical_attrs 19 19   0 120 0 0 0>
            , <&key_physical_attrs 19 19  24 120 0 0 0>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        row-gpios
            = <&gpio0  29 GPIO_ACTIVE_HIGH>
            , <&gpio0  10 GPIO_ACTIVE_HIGH>
            , <&gpio0 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 100 GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            ;
        col-gpios
            = <&gpio0  106 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>            
            , <&gpio0   31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0    2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  115 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  113 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>                            
            , <&gpio0  111 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  104 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        rows = <6>;
        columns = <8>;

        map = <
            /* Row 0 */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)

            /* Row 1 */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)

            /* Row 2 */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)

            /* Row 3 */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)

            /* Row 4 */
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)

            /* Row 5 */
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7)
        >;
    };
};